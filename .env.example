# RawEval Monorepo - Root Environment Variables
# 
# This file contains environment variables that apply to the entire monorepo.
# App-specific variables should be in apps/{app-name}/.env.example
#
# Copy this file to .env.local and fill in your values

# =============================================================================
# Global Configuration
# =============================================================================

# Node Environment
NODE_ENV=development

# =============================================================================
# Backend API Configuration (Default)
# =============================================================================

# Main API Base URL (used as default for all apps)
API_URL=http://raweval-alb-1123950706.ap-northeast-1.elb.amazonaws.com

# API Version
API_VERSION=v1

# LLM Call Host API Base URL
LLM_CALLS_API_URL=http://raweval-alb-1123950706.ap-northeast-1.elb.amazonaws.com

# =============================================================================
# Development Tools (OPTIONAL)
# =============================================================================

# Enable Turbo Remote Caching
# TURBO_TEAM=your-team-id
# TURBO_TOKEN=your-turbo-token

# =============================================================================
# Notes
# =============================================================================
#
# App-specific environment variables:
# - apps/chat/.env.example - Chat app configuration
# - apps/experts/.env.example - Experts app configuration
# - apps/admin/.env.example - Admin app configuration
# - apps/landing/.env.example - Landing app configuration
#
# Priority order:
# 1. .env.local (highest priority, git-ignored)
# 2. .env (git-ignored)
# 3. .env.example (committed to git, template only)
