{
  "name": "@raweval/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "API client for RawEval backend integration",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./interceptors": {
      "types": "./dist/interceptors.d.ts",
      "default": "./dist/interceptors.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@raweval/types": "workspace:*",
    "@raweval/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
