# Force pnpm only - reject npm/yarn
engine-strict=true

# Hoist all dependencies to root
shamefully-hoist=false

# Strict peer dependencies
strict-peer-dependencies=true

# Auto-install peers
auto-install-peers=true

# Disable package-lock.json (npm)
package-lock=false
# Enable pnpm-lock.yaml (required for Vercel)
lockfile=true

# Save exact versions
save-exact=true
