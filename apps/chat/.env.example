# RawEval Chat App - Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# Backend API Configuration
# =============================================================================

# Main API Base URL (REQUIRED)
NEXT_PUBLIC_API_URL=https://api.raweval.com

# API Version (REQUIRED)
NEXT_PUBLIC_API_VERSION=v1

# LLM Call Host API Base URL (OPTIONAL)
# If not set, defaults to NEXT_PUBLIC_API_URL
# We set it explicitly to production URL to be safe
NEXT_PUBLIC_LLM_CALLS_API_URL=https://api.raweval.com

# =============================================================================
# API Client Configuration (OPTIONAL)
# =============================================================================

# Request Timeout (milliseconds, default: 30000)
NEXT_PUBLIC_API_TIMEOUT=30000

# Number of Retries (default: 3)
NEXT_PUBLIC_API_RETRIES=3

# Retry Delay (milliseconds, default: 1000)
NEXT_PUBLIC_API_RETRY_DELAY=1000

# =============================================================================
# Development/Testing (OPTIONAL)
# =============================================================================

# Enable API request logging in development
NEXT_PUBLIC_DEBUG_API=false

# Mock API responses (for testing without backend)
NEXT_PUBLIC_MOCK_API=false
