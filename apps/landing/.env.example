# RawEval Landing App - Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# Backend API Configuration (OPTIONAL)
# =============================================================================
# Only needed if landing page makes API calls

# Main API Base URL
# NEXT_PUBLIC_API_URL=http://raweval-alb-1123950706.ap-northeast-1.elb.amazonaws.com

# API Version
# NEXT_PUBLIC_API_VERSION=v1

# =============================================================================
# Analytics & Tracking (OPTIONAL)
# =============================================================================

# Google Analytics ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Vercel Analytics
# Automatically enabled in production on Vercel
