# Environment: development | staging | production
APP_ENV=development

# API
EXPO_PUBLIC_API_URL=https://dev.api.raweval.com
EXPO_PUBLIC_API_VERSION=v1
EXPO_PUBLIC_API_TIMEOUT=30000
EXPO_PUBLIC_API_RETRIES=3
EXPO_PUBLIC_API_RETRY_DELAY=1000
EXPO_PUBLIC_DEBUG_API=false

# Razorpay — use rzp_test_ for dev/staging, rzp_live_ for production
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx

# Google OAuth
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# EAS (set after running eas init)
# EAS_PROJECT_ID=your-eas-project-id
