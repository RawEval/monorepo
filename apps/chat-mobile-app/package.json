{
  "name": "@raweval/chat-mobile-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --clear",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "web": "expo start --web --clear",
    "prebuild": "expo prebuild --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "prebuild:android": "expo prebuild --platform android --clean",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .expo ios android dist",
    "clean:native": "rm -rf ios android",
    "reset": "rm -rf node_modules .expo ios android dist && pnpm install && expo prebuild --clean",
    "build:dev": "eas build --profile development --platform all",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:sim": "eas build --profile development --platform ios",
    "build:staging": "eas build --profile staging --platform all",
    "build:staging:ios": "eas build --profile staging --platform ios",
    "build:staging:android": "eas build --profile staging --platform android",
    "build:prod": "eas build --profile production --platform all",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:prod:android": "eas build --profile production --platform android",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "update:staging": "eas update --channel staging",
    "update:prod": "eas update --channel production"
  },
  "dependencies": {
    "@react-navigation/drawer": "7.9.5",
    "@react-navigation/native": "^7.1.33",
    "@shopify/flash-list": "~2.0.2",
    "@tanstack/react-query": "5.90.21",
    "date-fns": "4.1.0",
    "expo": "~55.0.8",
    "expo-auth-session": "~55.0.9",
    "expo-clipboard": "~55.0.9",
    "expo-constants": "~55.0.9",
    "expo-crypto": "~55.0.10",
    "expo-document-picker": "~55.0.9",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.9",
    "expo-image": "~55.0.6",
    "expo-image-picker": "~55.0.13",
    "expo-linking": "~55.0.8",
    "expo-router": "~55.0.7",
    "expo-secure-store": "~55.0.3",
    "expo-splash-screen": "~55.0.12",
    "expo-status-bar": "~55.0.4",
    "expo-updates": "~55.0.15",
    "expo-web-browser": "~55.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "2.30.0",
    "react-native-markdown-display": "7.0.2",
    "react-native-razorpay": "2.3.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2",
    "zustand": "5.0.10"
  },
  "devDependencies": {
    "@raweval/config": "workspace:*",
    "@raweval/types": "workspace:*",
    "@types/react": "~19.2.14",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": ["react-native-razorpay"]
      }
    },
    "install": {
      "exclude": ["@react-navigation/drawer"]
    }
  }
}
